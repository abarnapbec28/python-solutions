class Solution {
private:
    // Map digits to their corresponding letters
    const vector<string> mapping = {
        "",     "",     "abc",  "def", 
        "ghi",  "jkl",  "mno",  "pqrs", 
        "tuv",  "wxyz"
    };

    void backtrack(const string& digits, int index, string& current, vector<string>& result) {
        // Base case: if the current combination is complete
        if (index == digits.length()) {
            result.push_back(current);
            return;
        }

        // Get the letters for the current digit
        string letters = mapping[digits[index] - '0'];
        for (char c : letters) {
            current.push_back(c);             // Choose the letter
            backtrack(digits, index + 1, current, result); // Recurse for the next digit
            current.pop_back();              // Backtrack
        }
    }

public:
    vector<string> letterCombinations(string digits) {
        vector<string> result;
        if (digits.empty()) {
            return result;
        }
        
        string current = "";
        backtrack(digits, 0, current, result);
        return result;
    }
};
