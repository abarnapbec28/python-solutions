#include <vector>

class Solution {
public:
    bool isValidSudoku(std::vector<std::vector<char>>& board) {
        // Track seen numbers (1-9 mapped to 0-8 indices)
        bool rows[9][9] = {false};
        bool cols[9][9] = {false};
        bool boxes[9][9] = {false};
        
        for (int i = 0; i < 9; ++i) {
            for (int j = 0; j < 9; ++j) {
                // Ignore empty cells
                if (board[i][j] == '.') {
                    continue;
                }
                
                // Convert char digit to 0-8 index
                int numIdx = board[i][j] - '1';
                int boxIdx = (i / 3) * 3 + (j / 3);
                
                // If the number already exists in this row, col, or box, it's invalid
                if (rows[i][numIdx] || cols[j][numIdx] || boxes[boxIdx][numIdx]) {
                    return false;
                }
                
                // Mark the number as seen
                rows[i][numIdx] = true;
                
                cols[j][numIdx] = true;
                boxes[boxIdx][numIdx] = true;
            }
        }
        
        return true;
    }
};
