#include <stdbool.h>

// Global bitmasks to track used digits for rows, columns, and 3x3 sub-boxes
int rows[9] = {0};
int cols[9] = {0};
int blocks[9] = {0};

bool backtrack(char** board, int r, int c) {
    // If we have reached past the last column, move to the next row
    if (c == 9) {
        r++;
        c = 0;
    }
    // Base Case: If we have filled all rows, the puzzle is solved successfully
    if (r == 9) {
        return true;
    }
    
    // Skip already filled cells and proceed to the next column
    if (board[r][c] != '.') {
        return backtrack(board, r, c + 1);
    }
    
    int blockIdx = (r / 3) * 3 + (c / 3);
    
    // Try placing digits from 1 to 9
    for (int num = 1; num <= 9; num++) {
        int mask = 1 << (num - 1);
        
        // If the number is already used in this row, column, or block, skip it
        if ((rows[r] & mask) || (cols[c] & mask) || (blocks[blockIdx] & mask)) {
            continue;
        }
        
        // Step 1: Place the digit and set the tracking bits
        board[r][c] = num + '0';
        rows[r] |= mask;
        cols[c] |= mask;
        blocks[blockIdx] |= mask;
        
        // Step 2: Recursively try solving the rest of the board
        if (backtrack(board, r, c + 1)) {
            return true; 
        }
        
        // Step 3: If it fails, backtrack (revert changes)
        board[r][c] = '.';
        rows[r] &= ~mask;
        cols[c] &= ~mask;
        blocks[blockIdx] &= ~mask;
    }
    
    return false; // Triggers backtracking to the previous cell
}

void solveSudoku(char** board, int boardSize, int* boardColSize) {
    // Reset global bitmask trackers (important for clean execution)
    for (int i = 0; i < 9; i++) {
        rows[i] = 0;
        cols[i] = 0;
        blocks[i] = 0;
    }
    
    // Step 1: Initialize the tracking bitmasks with the existing numbers on the board
    for (int i = 0; i < 9; i++) {
        for (int j = 0; j < 9; j++) {
            if (board[i][j] != '.') {
                int val = board[i][j] - '1';
                int mask = 1 << val;
                int blockIdx = (i / 3) * 3 + (j / 3);
                
                rows[i] |= mask;
                cols[j] |= mask;
                blocks[blockIdx] |= mask;
            }
        }
    }
    
    // Step 2: Run the backtracking algorithm starting from the top-left cell (0, 0)
    backtrack(board, 0, 0);
}
