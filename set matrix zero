#include <stdbool.h>

void setZeroes(int** matrix, int matrixSize, int* matrixColSize) {
    int rows = matrixSize;
    int cols = matrixColSize[0];
    bool firstColZero = false;

    // Step 1: Scan the matrix and use the first row & column as markers
    for (int i = 0; i < rows; i++) {
        // Check if the first column needs to be zeroed out later
        if (matrix[i][0] == 0) {
            firstColZero = true;
        }
        
        // Scan the rest of the columns
        for (int j = 1; j < cols; j++) {
            if (matrix[i][j] == 0) {
                matrix[i][0] = 0; // Mark the row
                matrix[0][j] = 0; // Mark the column
            }
        }
    }

    // Step 2: Use the markers to zero out inner cells (bottom-up/right-to-left approach)
    // We skip the first row and first column during this pass to preserve markers
    for (int i = 1; i < rows; i++) {
        for (int j = 1; j < cols; j++) {
            if (matrix[i][0] == 0 || matrix[0][j] == 0) {
                matrix[i][j] = 0;
            }
        }
    }

    // Step 3: Zero out the first row if its marker was set
    if (matrix[0][0] == 0) {
        for (int j = 0; j < cols; j++) {
            matrix[0][j] = 0;
        }
    }

    // Step 4: Zero out the first column if its independent tracker was set
    if (firstColZero) {
        for (int i = 0; i < rows; i++) {
            matrix[i][0] = 0;
        }
    }
}
